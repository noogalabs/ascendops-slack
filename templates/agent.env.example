# TEMPLATE ONLY. Replace every REPLACE_WITH value in the agent's approved secret
# storage. Keep the completed file outside this repository; never commit it.
# Each independent agent needs its OWN Slack app and its OWN two tokens.

# Bot User OAuth Token, obtained after installing this agent's Slack app.
SLACK_BOT_TOKEN=REPLACE_WITH_THIS_AGENT_BOT_TOKEN

# App-level token, generated separately with connections:write.
# This is not a bot OAuth scope and does not belong in the app manifest.
SLACK_APP_TOKEN=REPLACE_WITH_THIS_AGENT_APP_LEVEL_TOKEN

# Runtime-dependent primary conversation; this is NOT the access allowlist.
# In the audited public runtime, SLACK_CHANNEL alone does NOT start the inbound
# listener. Startup requires slack_watch.channel in the existing agent config;
# see agent.config.fragment.json and the compatibility guide before merging it.
# For a DM-only pilot, use the verified DM ID if your runtime supports booting
# its listener from that DM, and verify inbound delivery after the normal restart.
# Do not create an unrelated public channel or broaden access to make it start.
# The same approved conversation must also be allowed by the agent's routing.
SLACK_CHANNEL=REPLACE_WITH_PRIMARY_ALLOWED_CONVERSATION_ID
